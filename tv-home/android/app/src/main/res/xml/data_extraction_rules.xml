<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The smart home settings hold a Home Assistant token, and athome.xml the
     things typed at home (guest Wi-Fi password, calendar link, notes), and phonepage.xml the paired phones (PhoneAuth.kt): never in a backup and never
     copied to another device. The Matter controller's keys (the two chip.platform files and
     files/matter/) let whoever holds them control every Matter device added on this TV: the same. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ha.xml" />
        <exclude domain="sharedpref" path="athome.xml" />
        <exclude domain="sharedpref" path="chip.platform.KeyValueStore.xml" />
        <exclude domain="sharedpref" path="chip.platform.ConfigurationManager.xml" />
        <exclude domain="file" path="matter/" />
        <exclude domain="sharedpref" path="phonepage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ha.xml" />
        <exclude domain="sharedpref" path="athome.xml" />
        <exclude domain="sharedpref" path="chip.platform.KeyValueStore.xml" />
        <exclude domain="sharedpref" path="chip.platform.ConfigurationManager.xml" />
        <exclude domain="file" path="matter/" />
        <exclude domain="sharedpref" path="phonepage.xml" />
    </device-transfer>
</data-extraction-rules>
