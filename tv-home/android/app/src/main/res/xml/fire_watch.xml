<?xml version="1.0" encoding="utf-8"?>
<!-- Watches home windows and filters only Home keys: no content reading or feedback. -->
<!-- canRetrieveWindowContent is declared only so the TV delivers the events: some builds (a TCL
     Smart TV Pro on Android 12) hand window-change events only to services with this capability.
     The code reads nothing but the event's package and class names, never the screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/fire_watch_desc" />
