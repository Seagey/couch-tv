<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android's Watch Next list: what each app says you are in the middle of (keep watching, no computer needed). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Smart home, only with a doorbell set up: the doorbell card over whatever is playing.
         Not granted on install: apply.sh grants it over ADB only when config.json has a doorbell. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Updates (Home settings, Updates): hand a new release to Android's installer, which always
         asks the person at the TV first. Android also asks once to let this app install apps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Fire TV only: keep the Home button watch on after updates and reboots (FireWatch.kt).
         Never granted on install: apply.sh or guest-tv grants it over ADB on a Fire TV, undo takes it back. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- See every app that has a TV launcher entry, so the fallback grid and app tiles can list them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- Amazon's home, to tell a Fire TV apart (FireWatch.kt). -->
        <package android:name="com.amazon.tv.launcher" />
        <!-- The TV's input list, for the Input quick button when there is no bridge. -->
        <intent><action android:name="android.settings.TV_INPUT_SETTINGS" /></intent>
        <intent><action android:name="com.android.tv.action.VIEW_INPUTS" /></intent>
        <intent><action android:name="com.google.android.tv.action.VIEW_INPUTS" /></intent>
        <intent><action android:name="android.media.tv.action.SETUP_INPUTS" /></intent>
        <!-- A file picker, for the photos in Home settings (many TVs have none). -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- Android's "install unknown apps" switch for this app, before the first update. -->
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:label="Home"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Home"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- What Android's installer says about an update (Updater.kt). Only reachable through the
             app's own PendingIntent. -->
        <receiver android:name=".Updater$Result" android:exported="false" />

        <!-- Fire TV only: puts this home back when the Home key opens Amazon's home (FireWatch.kt).
             Off until a computer switches it on over ADB; it sees which window came forward and
             reads no screen content. -->
        <service
            android:name=".FireWatch"
            android:exported="false"
            android:label="Home button watch"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/fire_watch" />
        </service>
        <receiver android:name=".FireWatch$Restore" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
