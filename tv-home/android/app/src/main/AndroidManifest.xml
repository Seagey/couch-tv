<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android's Watch Next list: what each app says you are in the middle of (keep watching, no computer needed). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Smart home, only with a doorbell set up: the doorbell card over whatever is playing.
         Not granted on install: apply.sh grants it over ADB only when config.json has a doorbell. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Updates (Home settings, Updates): hand a new release to Android's installer, which always
         asks the person at the TV first. Android also asks once to let this app install apps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Holding OK on an app, "Uninstall": lets this app open Android's remove dialog. Without it
         the package installer closes straight away (Android 9 and newer). It always asks first. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Fire TV only: keep the Home button watch on after updates and reboots (FireWatch.kt).
         Never granted on install: apply.sh or guest-tv grants it over ADB on a Fire TV, undo takes it back. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- The screensaver quick button shortens the screen timeout for a moment so the TV starts
         its own screensaver; the TV allows that with a "modify system settings" app-op that
         apply.sh grants once over ADB. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- See every app that has a TV launcher entry, so the fallback grid and app tiles can list them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- The TV's own homes: the Home button watch looks for them (FireWatch.kt), and the crash
             guard hands the screen to one if couch-tv keeps crashing (CrashGuard.kt). -->
        <package android:name="com.amazon.tv.launcher" />
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tvlauncher" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The screensaver (#86): Screensaver quick button checks the TV's dream is enabled, and the
             look settings open the ambient settings. Android 11+ hides these packages otherwise
             (an onn 4K Pro, Android 14, showed no Screensaver button). -->
        <intent><action android:name="android.service.dreams.DreamService" /></intent>
        <intent><action android:name="dreamx.two.panel.SETTINGS" /></intent>
        <package android:name="com.google.android.apps.tv.dreamx" />
        <!-- The TV's input list, for the Input quick button when there is no bridge. -->
        <intent><action android:name="android.settings.TV_INPUT_SETTINGS" /></intent>
        <intent><action android:name="com.android.tv.action.VIEW_INPUTS" /></intent>
        <intent><action android:name="com.google.android.tv.action.VIEW_INPUTS" /></intent>
        <intent><action android:name="android.media.tv.action.SETUP_INPUTS" /></intent>
        <!-- The Input menu (#30): the TV's own app that plays an input when asked to view its
             passthrough channel (content://android.media.tv/passthrough/<input>). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <!-- The Input menu's Bluetooth and Network rows: the TV's own settings screens. -->
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIRELESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <!-- A file picker, for the photos in Home settings (many TVs have none). -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- Android's "install unknown apps" switch for this app, before the first update. -->
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
            <data android:scheme="package" />
        </intent>
        <!-- Holding OK on an app, "Uninstall": Android's remove dialog (the package installer). -->
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
        <!-- Holding OK on an app, "App info", and the uninstall fallback on TVs with no remove dialog. -->
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="Home"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Home"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- What Android's installer says about an update (Updater.kt). Only reachable through the
             app's own PendingIntent. -->
        <receiver android:name=".Updater$Result" android:exported="false" />

        <!-- The Home button watch: puts this home back when the Home key (or the TV at power on)
             opens the TV's own home, which stays switched on (FireWatch.kt). Fire TV, Google TV and
             Android TV. Off until a computer switches it on over ADB; it sees which window came
             forward and reads no screen content. -->
        <service
            android:name=".FireWatch"
            android:exported="false"
            android:label="Home button watch"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/fire_watch" />
        </service>
        <!-- The remote's gear button on TVs that never hand it to an app (KeyWatch.kt). Off until the
             person at the TV switches it on in Accessibility; it catches only that button and reads no screen content. -->
        <service
            android:name=".KeyWatch"
            android:exported="false"
            android:label="Home gear button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/key_watch" />
        </service>
        <receiver android:name=".FireWatch$Restore" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
