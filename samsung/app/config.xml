<?xml version="1.0" encoding="UTF-8"?>
<!-- couch-tv for Samsung TVs (Tizen). samsung/build.py copies the TV home (tv-home/web) next to
     this file and packs it as build/samsung/CouchTV.wgt. See docs/SAMSUNG.md. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/couch-tv/samsung" version="1.0.0" viewmodes="maximized">
  <tizen:application id="CouchTVApp.Home" package="CouchTVApp" required_version="2.3"/>
  <content src="boot.html"/>
  <name>Couch TV</name>
  <icon src="icon.png"/>
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
  <!-- Samsung's own player (AVPlay) for Live TV (livetv.js); Samsung's AVPlay samples ask for it -->
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
  <!-- tizen.js brings couch-tv back after Samsung's Home with this operation: the page that is
       already up gets an appcontrol event instead of loading again -->
  <tizen:app-control>
    <tizen:src name="index.html" reload="disable"/>
    <tizen:operation name="http://couch-tv.app/appcontrol/operation/front"/>
  </tizen:app-control>
</widget>
