<?xml version="1.0" encoding="utf-8"?>
<!-- The "watch" build of the on-TV app (couch-tv-ontv-watch.apk): the same app plus the home watch.
     Installed from a computer (Fire TV, docs/FIRE-TV-STICK.md, or a TV whose maker's home ignores the
     default home). Not the phone only download: Play Protect blocks a sideloaded app with an
     accessibility service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Fire TV only, and only used when "Use as home screen" is on. Window-change events only:
             it reads no screen content. FireHome switches it on with the secure-settings grant. -->
        <service
            android:name=".WatchService"
            android:exported="false"
            android:label="Couch TV home watch"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/watch_service" />
        </service>
    </application>
</manifest>
