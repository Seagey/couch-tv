<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. allowBackup="false" stops cloud backups but not a device to device copy
     (a new TV set up from the old one). Nothing of this app is copied: it holds the pairing tokens of
     every phone and the Matter controller's keys, which let whoever holds them control every Matter
     device added on this TV. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
