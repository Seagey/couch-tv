# Copy to examples/docker/.env (keep it private: chmod 600) and fill in.
# Your time zone, for example Australia/Sydney or America/New_York.
TZ=UTC
# LG only: the TV's address on your network, and the 6 character passphrase from its Developer
# Mode app. Leave TV_IP empty for other TVs.
TV_IP=
ARES_DEVICE=lounge
LG_PASSPHRASE=
